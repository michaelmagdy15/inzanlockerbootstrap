# Server Settings
PORT=3000
NODE_ENV=production

# MQTT Broker Details
MQTT_BROKER=mqtt://192.168.68.2
MQTT_PORT=1883
MQTT_USER=mqtt
MQTT_PASSWORD=your_secure_password_here
MQTT_TOPIC_TEMPLATE=gym/lockers/{id}/command

# Wallet / PWA Settings
# URL where this server is publicly accessible (or locally via HTTPS/domain)
# e.g., https://locker.local or https://yourdomain.com
BASE_URL=http://192.168.68.2:3000

# Apple Wallet Credentials (Required if generating signed .pkpass files)
# To generate a functional Apple Wallet pass, you must sign it with an Apple Developer Certificate.
# Apple Wallet PASS_TYPE_IDENTIFIER (e.g. pass.com.yourcompany.gym)
APPLE_PASS_TYPE_IDENTIFIER=
# Apple TEAM_IDENTIFIER (10-character alphanumeric string)
APPLE_TEAM_IDENTIFIER=
# Path to the Apple WWDR intermediate certificate (PEM format)
APPLE_WWDR_CERT_PATH=certs/wwdr.pem
# Path to the Pass Type Identifier certificate (PEM format)
APPLE_PASS_CERT_PATH=certs/pass.pem
# Path to the private key associated with the Pass Type Certificate (PEM format)
APPLE_PASS_KEY_PATH=certs/pass.key
# Password for the private key (if encrypted)
APPLE_PASS_KEY_PASSWORD=
